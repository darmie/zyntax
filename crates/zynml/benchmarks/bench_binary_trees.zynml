import prelude

// Binary trees, the allocation benchmark.
//
// Every other kernel here measures arithmetic. This one measures the
// allocator: it builds and releases millions of short-lived nodes and
// does almost nothing with them, so the time is the cost of taking
// memory and giving it back. Held against the same program in C, it
// says what a ZynML allocation costs.
//
// The shape is the reference one. A tree of depth `d` is built bottom
// up, checked, and released; one tree deeper than any other is built
// and released first so the heap has been stretched before anything is
// meant to survive; and one is held to the end so every round runs
// against memory the allocator cannot reclaim.
//
// `n = 16` puts the working set past any cache and the allocation count
// in the tens of millions.

@reference
struct Node {
    left: Node,
    right: Node,
    item: i64
}

impl Node {
    /// A tree of `depth`, built bottom up. A leaf is a node whose
    /// children are absent, which is what `check` reads to stop.
    def build(item: i64, depth: i64): Node {
        if depth > 0 {
            return Node {
                left: Node::build(2 * item - 1, depth - 1),
                right: Node::build(2 * item, depth - 1),
                item: item
            }
        }
        return Node { left: null, right: null, item: item }
    }

    /// Walk every node, so a tree that was built wrong is a checksum
    /// that comes out wrong rather than time that was never spent.
    def check(self): i64 {
        if self.left == null {
            return self.item
        }
        return self.item + self.left.check() - self.right.check()
    }

    /// Release the tree, children first. The point of the benchmark:
    /// the nodes go back in the order they will be handed out again.
    ///
    /// `own` says the call ends the caller's claim, so this is the
    /// release rather than one more read. A receiver with nothing
    /// stated is borrowed, and a borrow that frees is a release its
    /// caller does not know happened.
    def release(own self: Node) {
        if self.left != null {
            self.left.release()
            self.right.release()
        }
        free(self as Ptr<i8>)
    }
}

def main(): i64 {
    let min_depth: i64 = 4
    let n: i64 = 16
    let mut max_depth: i64 = n
    if min_depth + 2 > max_depth { max_depth = min_depth + 2 }
    let stretch_depth: i64 = max_depth + 1

    let stretch: Node = Node::build(0, stretch_depth)
    let mut result: i64 = stretch.check()
    stretch.release()

    let long_lived: Node = Node::build(0, max_depth)

    let mut depth: i64 = min_depth
    while depth <= max_depth {
        let iterations: i64 = 1 << (max_depth - depth + min_depth)
        let mut check: i64 = 0
        let mut i: i64 = 0
        while i < iterations {
            let t1: Node = Node::build(i, depth)
            check = check + t1.check()
            t1.release()
            let t2: Node = Node::build(0 - i, depth)
            check = check + t2.check()
            t2.release()
            i = i + 1
        }
        result = result ^ check
        depth = depth + 2
    }

    result = result ^ long_lived.check()
    long_lived.release()
    return result
}
